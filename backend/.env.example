# CyberSchola backend environment.
# Copy to .env and fill in. Never commit .env, and never paste real values
# into a pull request, a screenshot, or a chat message.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# ---------------------------------------------------------------------------
# Supabase (decision 17A)
# Authentication is Supabase. Tenant and role always resolve from the
# membership table, never from a token body.
#
# Read by the backend: SUPABASE_URL and SUPABASE_JWKS_URL, and nothing else.
# Both are required and validated at boot, so the process will not start
# without them. Authentication is not something this application can run
# without, and booting into a state where the guard cannot verify anything is
# an invitation for somebody to "temporarily" disable it.
#
# The token issuer is derived from SUPABASE_URL rather than configured
# separately, so the two cannot disagree.
#
# SUPABASE_PUBLISHABLE_KEY is deliberately absent. It is a client-side key used
# by the frontend to talk to Supabase directly; no backend code reads it, and
# listing it here would misrepresent this file, which is meant to be the
# backend's actual configuration contract. env.validation.spec.ts now holds
# that claim to a test rather than to good intentions.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_JWKS_URL=

# NOT read by any backend code, and it must stay that way. This key bypasses
# row-level security, so anything using it has no tenant isolation whatsoever.
# It is kept here as documentation for out-of-band operational scripts, and as
# a warning: if it ever appears in the request path, every policy in the system
# stops applying to that query.
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Database (decisions 18A and 20A)
# DATABASE_URL  : transaction pooler on 6543, used by the API and the worker.
#                 Keep ?pgbouncer=true, and keep prepared statements disabled.
# DIRECT_URL    : session pooler on 5432, used only by migrations.
#
# The API connects as a role without BYPASSRLS. Migrations connect as the
# owning role. Using the service role or `postgres` for DATABASE_URL silently
# disables every row-level security policy.
# ---------------------------------------------------------------------------
DATABASE_URL=
DIRECT_URL=
DATABASE_SSL=true

# Keep this modest. Every API replica and the worker share one pooler budget.
DATABASE_POOL_MAX=10

# ---------------------------------------------------------------------------
# Redis (decision 15A)
# The instance must run maxmemory-policy noeviction. Every cache key carries
# a TTL; quota, rate limit and queue keys do not expire and must never be
# evicted.
# ---------------------------------------------------------------------------
REDIS_URL=

# Set to "true" only if your Redis provider blocks CONFIG GET, so the boot check
# cannot verify that maxmemory-policy is noeviction, AND you have confirmed with
# the provider that keys are never evicted. Leaving it unset is correct almost
# everywhere: the application then refuses to start rather than assume.
# It does not silence a policy we can read and know to be wrong.
REDIS_ALLOW_UNKNOWN_EVICTION_POLICY=

# ---------------------------------------------------------------------------
# Browser access
# ---------------------------------------------------------------------------
# Exact origins allowed to call the API from a browser, comma-separated, such
# as https://app.example.com,http://localhost:3001. Leave blank for none: the
# API documentation is served from the API's own origin and needs no entry.
CORS_ORIGINS=

# ---------------------------------------------------------------------------
# LiveKit (P5, live classes)
# Token minting is server side under decision 19A, so the secret belongs here
# and never in the browser bundle. The wss:// URL and the API key are the
# frontend's NEXT_PUBLIC_ variables and are set in the frontend package.
# ---------------------------------------------------------------------------
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=

# ---------------------------------------------------------------------------
# Paystack (P7 onward, subscription entitlements)
# Only the secret key belongs here. The pk_test_ / pk_live_ publishable key is
# designed to be public and is set in the frontend package.
# ---------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=

# ---------------------------------------------------------------------------
# Integration tests
# Points at a throwaway database. The suite drops and rebuilds the schema on
# every run, so this must never be a development or production URL. It is a
# separate variable from DATABASE_URL precisely so that cannot happen by
# accident.
#
#   docker compose up -d postgres-test
# ---------------------------------------------------------------------------
TEST_DATABASE_URL=
GROQ_API_KEY=